{
  "app_name": "WordLens",
  "target_level": "B2-C1",
  "source_language": "English",
  "target_language": "Spanish",
  "hotkey_start": "ctrl+shift+v",
  "hotkey_stop": "ctrl+shift+x",
  "document_path": "Vocabulario.docx",
  "backup_count": 10,
  "monitor": 1,
  "capture_interval_seconds": 0.5,
  "top_band_fraction": 0.33,
  "bottom_band_fraction": 0.33,
  "scan_top": true,
  "scan_bottom": true,
  "ocr_language": "en-US",
  "ocr_preprocess": "subtitle",
  "require_centered": true,
  "min_words_per_line": 2,
  "min_english_ratio": 0.7,
  "stability_frames": 2,
  "repeat_window_seconds": 180.0,
  "similarity_threshold": 0.85,
  "ollama_url": "http://localhost:11434",
  "ollama_model": "maternion/ling-3.0-tiny:8b",
  "ollama_timeout_seconds": 180.0,
  "ollama_keep_alive": "30m",
  "temperature": 0.0,
  "batch_max_lines": 4,
  "batch_wait_seconds": 1.5,
  "max_queue_lines": 40,
  "prefilter_trivial_lines": true,
  "max_single_word_zipf": 4.5,
  "max_expression_words": 6,
  "notifications": true
}